{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "mty/timeline",
    "version": "0.2.0",
    "title": "Timeline",
    "category": "mty",
    "description": "A row of steps joined by one line, each marked by a square dot, with your own blocks below.",
    "allowedBlocks": ["mty/timeline-step"],
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "attributes": {
        "steps": {
            "type": "number",
            "default": 4
        },
        "columns": {
            "type": "number",
            "default": 4
        },
        "color": {
            "type": "string",
            "default": "#FFFFFF"
        },
        "activeColor": {
            "type": "string",
            "default": "#29A852"
        }
    },
    "example": {},
    "textdomain": "mty",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css"
}
