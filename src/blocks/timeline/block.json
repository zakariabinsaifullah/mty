{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "mty/timeline",
    "version": "0.4.0",
    "title": "Timeline",
    "category": "mty",
    "description": "A row of steps joined by one line, each marked by a square dot, with your own blocks below. The highlighted step can colour its dot only, or its dot and line.",
    "allowedBlocks": [
        "mty/timeline-step"
    ],
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "attributes": {
        "steps": {
            "type": "number",
            "default": 4
        },
        "columns": {
            "type": "number",
            "default": 4
        },
        "color": {
            "type": "string",
            "default": ""
        },
        "activeColor": {
            "type": "string",
            "default": ""
        },
        "highlightLine": {
            "type": "boolean",
            "default": false
        },
        "activeLineColor": {
            "type": "string",
            "default": ""
        },
        "gap": {
            "type": "number",
            "default": 40
        },
        "contentGap": {
            "type": "number",
            "default": 40
        },
        "highlightOnHover": {
            "type": "boolean",
            "default": false
        }
    },
    "example": {},
    "textdomain": "mty",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css"
}
