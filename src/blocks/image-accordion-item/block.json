{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "mty/image-accordion-item",
    "version": "1.0.0",
    "title": "Image Accordion Item",
    "category": "mty",
    "icon": "format-image",
    "description": "Individual image, icon, number and title for the Image Accordion block.",
    "example": {},
    "parent": ["mty/image-accordion"],
    "usesContext": ["mty/showTitle", "mty/titleTag"],
    "supports": {
        "anchor": true,
        "html": false,
        "align": false,
        "reusable": false,
        "color": {
            "text": false,
            "background": true,
            "gradients": true,
            "__experimentalDefaultControls": {
                "background": false
            }
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true,
            "__experimentalDefaultControls": {
                "color": false,
                "radius": false,
                "width": false
            }
        },
        "spacing": {
            "padding": true,
            "__experimentalDefaultControls": {
                "padding": false
            }
        },
        "shadow": true
    },
    "attributes": {
        "image": {
            "type": "object",
            "default": {
                "id": "",
                "url": "",
                "alt": ""
            }
        },
        "imageTablet": {
            "type": "object",
            "default": {
                "id": "",
                "url": "",
                "alt": ""
            }
        },
        "imageMobile": {
            "type": "object",
            "default": {
                "id": "",
                "url": "",
                "alt": ""
            }
        },
        "itemStyle": {
            "type": "object"
        },
        "iconName": {
            "type": "string"
        },
        "customSvgCode": {
            "type": "string"
        },
        "iconType": {
            "type": "string",
            "default": "fill"
        },
        "strokeWidth": {
            "type": "number",
            "default": 1.2
        },
        "number": {
            "type": "string"
        },
        "showTitle": {
            "type": "boolean",
            "default": true
        },
        "title": {
            "type": "string"
        },
        "titleTag": {
            "type": "string",
            "default": "h4"
        }
    },
    "textdomain": "mty",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css"
}
