{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "mty/rating",
    "version": "1.0.0",
    "title": "Rating",
    "category": "mty",
    "description": "SVG-based star rating system with customizable values.",
    "supports": {
        "anchor": true,
        "html": false,
        "align": [
            "wide",
            "full"
        ],
        "spacing": {
            "margin": true,
            "padding": true,
            "__experimentalDefaultControls": {
                "margin": false,
                "padding": false
            }
        }
    },
    "attributes": {
        "blockStyle": {
            "type": "object"
        },
        "totalRating": {
            "type": "number",
            "default": 5
        },
        "enableRating": {
            "type": "boolean",
            "default": false
        },
        "ratingText": {
            "type": "string",
            "default": "4.5"
        },
        "nrPos": {
            "type": "string",
            "default": "nr_right"
        },
        "ratingSize": {
            "type": "number"
        },
        "ratingNsize": {
            "type": "number"
        },
        "ratingColor": {
            "type": "string"
        },
        "nuRatColor": {
            "type": "string"
        },
        "alignment": {
            "type": "string",
            "default": ""
        }
    },
    "textdomain": "mty",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css"
}
